{
  "schemaVersion": 1,
  "id": "tconstruct",
  "version": "${version}",
  "name": "Tinkers' Construct",
  "description": "A little of this, a little of that, a lot of tinkering, and a lot of tools",
  "authors": ["Slime Knights"],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/tinkers-construct",
    "issues": "https://github.com/SlimeKnights/TinkersConstruct/issues"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "accessWidener": "tconstruct.accesswidener",
  "mixins": ["tconstruct.mixins.json"],
  "entrypoints": {
    "main": ["slimeknights.tconstruct.TConstruct"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_range}",
    "mantle": "*",
    "java": ">=21"
  },
  "suggests": {
    "jei": "${jei_range}"
  }
}
